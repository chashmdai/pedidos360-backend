{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chashmdai/pedidos360-backend/contracts/product-sales-metric-v1.schema.json",
  "title": "ProductSalesMetricV1",
  "description": "Estado completo (no incremento) de un acumulado diario por producto. Tópico compactado pedidos360.sales.product-metrics.v1, clave = metricKey = tenantId:productId:businessDate:currency. revenue es importe solicitado, no pagos. El record Java valida además que metricKey coincida con sus componentes.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "metricKey", "tenantId", "productId", "productName", "businessDate", "currency", "unitsSold", "ordersCount", "revenue", "version", "lastEventId", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "metricKey": { "type": "string", "pattern": "^.{1,100}:[0-9a-fA-F-]{36}:[0-9]{4}-[0-9]{2}-[0-9]{2}:[A-Z]{3}$" },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "productId": { "type": "string", "format": "uuid" },
    "productName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "businessDate": { "type": "string", "format": "date", "description": "AAAA-MM-DD en UTC." },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "unitsSold": { "type": "integer", "minimum": 0 },
    "ordersCount": { "type": "integer", "minimum": 0 },
    "revenue": { "type": "number", "minimum": 0, "multipleOf": 0.01 },
    "version": { "type": "integer", "minimum": 1, "description": "Creciente por clave; descarta actualizaciones antiguas fuera de orden." },
    "lastEventId": { "type": "string", "format": "uuid" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "examples": [{
    "schemaVersion": 1,
    "metricKey": "72fd0b5a-8a6a-4cff-89f6-bde961f7e250:10000000-0000-0000-0000-000000000001:2026-11-24:CLP",
    "tenantId": "72fd0b5a-8a6a-4cff-89f6-bde961f7e250",
    "productId": "10000000-0000-0000-0000-000000000001",
    "productName": "Café de especialidad",
    "businessDate": "2026-11-24",
    "currency": "CLP",
    "unitsSold": 3,
    "ordersCount": 2,
    "revenue": 56970.00,
    "version": 2,
    "lastEventId": "6f1c2b0e-8d4a-4f7b-9e21-3c5a7d9b1e40",
    "updatedAt": "2026-11-24T14:05:13.120000Z"
  }]
}
